{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.js"],
  "exclude": ["dist", "node_modules", "tests"]
}

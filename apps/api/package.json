{
  "name": "market-server",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --ignore dist --exec ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "migrate": "ts-node db/run-migrate.ts",
    "backfill": "ts-node db/run-backfill.ts",
    "setup": "npm run migrate && npm run backfill"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "google-auth-library": "^9.15.1",
    "multer": "^2.0.2",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.0.5",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
